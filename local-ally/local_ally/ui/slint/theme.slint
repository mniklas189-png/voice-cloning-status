// Farben, Masse und die wiederkehrenden Bausteine der Oberflaeche.
//
// Gestaltungsleitlinie: Local Ally soll wie ein praezises Werkzeug wirken,
// nicht wie ein Produkt-Schaufenster. Deshalb bewusst:
//
//   * keine Farbverlaeufe, keine Leuchteffekte, keine weichen Schatten
//   * eine fast einfarbige Palette; Farbe traegt Bedeutung statt Dekoration
//     (Rot = Aufnahme laeuft, Gruen = erledigt, Akzent = Auswahl/Pegel)
//   * Trennung durch 1px-Haarlinien statt durch gestapelte Kaesten
//   * Hierarchie ueber Schriftgroesse, -staerke und Laufweite
//
// Beide Farbschemata stammen aus der Bildmarke: dunkel das Marineblau mit
// Stahlblau, hell das Cremeweiss mit Olivschwarz. `dark` setzt Python aus
// den Einstellungen; alle Farben haengen davon ab und aendern sich sofort.

export global Theme {
    in-out property <bool> dark: true;

    // Flaechen
    out property <brush> background: dark ? #0b1a2a : #f3efe4;
    out property <brush> surface: dark ? #102438 : #faf7ee;
    out property <brush> surface-raised: dark ? #163046 : #ffffff;
    out property <brush> sidebar: dark ? #081420 : #ebe5d6;

    // Linien
    out property <brush> line: dark ? #1a3448 : #ddd6c3;
    out property <brush> line-strong: dark ? #2b5570 : #bdb49c;
    out property <color> meter-off: dark ? #14293b : #ded8c8;

    // Text
    out property <color> text: dark ? #eaf1f7 : #23231a;
    out property <color> text-muted: dark ? #93aec4 : #6a675b;
    out property <color> text-faint: dark ? #62819a : #928e80;

    // Bedeutungstragende Farben
    out property <color> accent: dark ? #5f93b4 : #2c2c21;   // Marke: Stahlblau / Olivschwarz
    out property <color> record: dark ? #e0574a : #c0392b;
    out property <color> success: dark ? #56ad86 : #47804f;
    out property <color> warning: dark ? #d3a05a : #94661d;
    out property <color> danger: dark ? #e0574a : #c0392b;

    // Interaktion ist unbunt: die Hauptaktion kehrt Vorder- und
    // Hintergrund um, statt eine weitere Farbe einzufuehren.
    out property <color> primary: dark ? #eaf1f7 : #23231a;
    out property <color> on-primary: dark ? #0b1a2a : #f3efe4;
    out property <brush> hover: dark ? #ffffff12 : #0000000d;

    // Masse
    out property <length> radius: 10px;
    out property <length> radius-small: 6px;
    out property <length> gap: 18px;
    out property <length> pad: 20px;

    // Schrift fuer Pfade und Kennzahlen. Consolas gibt es auf jedem
    // Windows; anderswo faellt Slint auf die Standardschrift zurueck.
    out property <string> mono: "Consolas";
}

// Waagerechte Haarlinie - das Trennmittel der Wahl.
export component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

// Flaeche mit Rahmen. Ersetzt die frueheren Karten: eine Ebene weniger,
// dafuer klare Kanten.
export component Panel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
}

// Kleine Grossbuchstaben-Beschriftung ueber einem Abschnitt.
export component SectionLabel inherits Text {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: Theme.text-faint;
}

// Quadratischer Statuspunkt - eckig, damit er nicht wie eine Leuchtdiode
// eines Chat-Fensters wirkt.
export component StatusDot inherits Rectangle {
    in property <color> tint: Theme.text-muted;
    width: 7px;
    height: 7px;
    border-radius: 1px;
    background: tint;
}

// Status in einer Zeile: Punkt plus Text.
export component StatusChip inherits HorizontalLayout {
    in property <string> label;
    in property <color> tint: Theme.text-muted;
    spacing: 8px;

    VerticalLayout {
        alignment: center;
        StatusDot { tint: root.tint; }
    }
    Text {
        text: root.label;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
    }
}

// Flacher Knopf. `strong` macht ihn zur Hauptaktion (helle Flaeche),
// sonst bleibt er ein Rahmen ohne Fuellung.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> strong: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    min-width: label.preferred-width + 32px;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: strong ? transparent
        : touch.has-hover && enabled ? Theme.line-strong : Theme.line;
    background: !enabled ? Theme.surface-raised
        : strong ? (touch.has-hover ? #ffffff : Theme.primary)
        : (touch.has-hover ? Theme.hover : transparent);
    animate background, border-color { duration: 100ms; }

    label := Text {
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: !root.enabled ? Theme.text-faint
            : root.strong ? Theme.on-primary : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Eigener Schalter statt der Standard-CheckBox: die bringt die blaue
// Systemfarbe mit und faellt in dieser Palette auf. Gebaut aus zwei
// Rechtecken - damit sieht er auf jedem System gleich aus, unabhaengig
// von installierten Schriften oder Symbolzeichensaetzen.
export component Toggle inherits HorizontalLayout {
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);

    spacing: 10px;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 34px;
            height: 19px;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent
                : touch.has-hover ? Theme.line-strong : Theme.line;
            background: root.checked ? Theme.accent : Theme.surface-raised;
            animate background, border-color { duration: 120ms; }

            Rectangle {
                x: root.checked ? parent.width - self.width - 3px : 3px;
                y: (parent.height - self.height) / 2;
                width: 13px;
                height: 13px;
                border-radius: self.width / 2;
                background: root.checked ? Theme.on-primary : Theme.text-muted;
                animate x, background { duration: 120ms; easing: ease-out; }
            }
        }
    }

    VerticalLayout {
        alignment: center;
        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.text;
        }
    }

    Rectangle { horizontal-stretch: 1; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}
