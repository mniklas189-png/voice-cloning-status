// Datenstrukturen und globale Zustaende der Oberflaeche.
//
// Die UI besitzt keinen eigenen Zustand: Python setzt die Eigenschaften in
// `Store`, die UI meldet Aktionen ueber `Actions` zurueck. Dadurch bleibt die
// Bruecke zwischen Python und Slint eine reine Kopieroperation.

export struct AppRow {
    id: int,
    name: string,
    detail: string,     // Pfad oder Startbefehl
    source: string,     // woher der Eintrag stammt
    aliases: string,
}

export struct CandidateRow {
    index: int,
    name: string,
    detail: string,
    score: string,      // z.B. "92 %"
    reason: string,
}

// Eine gespeicherte eigene Funktion in der Uebersicht.
export struct CustomRow {
    id: int,
    phrase: string,
    action: string,          // Id der Aktionsart
    action-label: string,    // "Website öffnen"
    action-short: string,    // "Website"
    target: string,
    enabled: bool,
    uses: string,            // "12 ×" oder leer
}

// Der Bearbeitungsstand des Formulars.
//
// Bewusst als Liste mit genau einem Eintrag in `Store.custom-form`: ein
// Wiederholer baut seine Kinder neu auf, sobald sich das Modell aendert.
// Nur so uebernehmen die Eingabefelder beim Wechsel auf eine andere
// Funktion wirklich neue Werte - ein gebundener Text wuerde nach der
// ersten Eingabe des Nutzers nicht mehr nachziehen.
export struct CustomForm {
    edit-id: int,            // 0 = neue Funktion
    phrase: string,
    action: string,
    action-short: string,
    config-label: string,    // "Adresse", "Befehl", ...
    placeholder: string,
    hint: string,
    picks-app: bool,         // Programmvorschlaege anbieten?
    target: string,
}

export struct EngineRow {
    id: string,
    name: string,
    description: string,
    available: bool,
    detail: string,
}

export global Store {
    // Spracherkennung
    in-out property <string> status: "idle";          // idle|loading|listening|working|error
    in-out property <string> status-label: "Bereit";
    in-out property <bool> listening: false;
    in-out property <float> level: 0.0;               // Mikrofonpegel 0..1
    in-out property <string> partial-text: "";
    in-out property <string> recognized-text: "";

    // Aktivierung
    in-out property <bool> muted: false;
    in-out property <bool> wake-enabled: false;
    in-out property <string> wake-word: "Hey Ally";
    in-out property <bool> wake-armed: false;
    in-out property <string> wake-heard: "";       // gehört, aber ohne Wake Word verworfen
    in-out property <bool> ptt-enabled: false;
    in-out property <bool> ptt-active: false;

    // Globale Tastenkürzel
    in-out property <bool> hotkeys-enabled: true;
    in-out property <string> mute-hotkey: "";
    in-out property <string> ptt-hotkey: "";
    in-out property <string> hotkey-detail: "";
    in-out property <string> hotkey-error: "";     // leer = alles in Ordnung
    in-out property <bool> hotkeys-ok: false;

    // Ergebnis des letzten Befehls
    in-out property <string> action-text: "";
    in-out property <bool> action-ok: true;
    in-out property <[CandidateRow]> candidates: [];
    in-out property <bool> awaiting-choice: false;
    in-out property <bool> awaiting-confirm: false;   // kritische Aktion wartet
    in-out property <bool> confirm-critical: true;

    // Laufende Timer als fertige Beschriftungen ("09:58 · 10 Minuten")
    in-out property <[string]> timers: [];

    // Programme
    in-out property <[AppRow]> apps: [];
    in-out property <int> app-count: 0;
    in-out property <bool> indexing: false;
    in-out property <string> index-detail: "";
    in-out property <string> last-index: "";

    // Eigene Funktionen
    in-out property <[CustomRow]> custom-commands: [];
    in-out property <[CustomForm]> custom-form: [];
    in-out property <[string]> custom-actions: [];      // Kurznamen zur Auswahl
    in-out property <[string]> custom-app-matches: [];  // Vorschlaege zur Programmauswahl
    in-out property <string> custom-error: "";
    in-out property <string> custom-hint: "";

    // Einstellungen
    // Auswahlen laufen ueberall ueber den *Wert*, nicht ueber einen Index:
    // das haelt Python und Oberflaeche auch dann synchron, wenn sich die
    // Liste dazwischen aendert (z.B. ein Mikrofon wird abgezogen).
    in-out property <[EngineRow]> engines: [];
    in-out property <string> engine-id: "vosk";
    in-out property <[string]> whisper-sizes: ["tiny", "base", "small", "medium", "large-v3"];
    in-out property <string> whisper-value: "small";
    in-out property <[string]> input-devices: [];
    in-out property <string> input-device-value: "";
    in-out property <string> vosk-model-path: "";
    in-out property <bool> auto-execute: true;
    in-out property <bool> include-path: true;

    in-out property <string> error: "";
    in-out property <string> version: "";
}

export global Actions {
    callback toggle-listening();
    callback rebuild-index();
    callback filter-apps(string);
    callback launch-app(int);          // App-Id
    callback choose-candidate(int);    // Position in der Vorschlagsliste
    callback dismiss-candidates();
    callback confirm-pending();
    callback decline-pending();
    callback set-confirm-critical(bool);
    callback toggle-mute();
    callback set-wake-enabled(bool);
    callback set-wake-word(string);
    callback set-ptt-enabled(bool);
    callback set-hotkeys-enabled(bool);
    callback set-mute-hotkey(string);
    callback set-ptt-hotkey(string);
    callback select-theme(string);         // "dark" oder "light"
    callback select-engine(string);        // Anzeigename des Erkenners
    callback select-whisper-size(string);
    callback select-input-device(string);
    callback set-vosk-model-path(string);
    callback set-auto-execute(bool);
    callback set-include-path(bool);

    // Eigene Funktionen
    callback custom-new();
    callback custom-edit(int);            // Id
    callback custom-delete(int);
    callback custom-run(int);
    callback custom-set-enabled(int, bool);
    callback custom-set-phrase(string);
    callback custom-select-action(string);  // Kurzname der Aktionsart
    callback custom-set-target(string);
    callback custom-pick-app(string);
    callback custom-save();
}
