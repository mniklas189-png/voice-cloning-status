// Hauptfenster: Seitenleiste + Inhaltsbereich.
//
// Die Struktur ist absichtlich flach gehalten: eine Navigationsspalte und
// drei Seiten. Weitere Seiten brauchen nur einen Eintrag in `nav-items`
// und einen zusaetzlichen `if`-Zweig im Inhaltsbereich.

import { Theme } from "theme.slint";
import { Store, Actions, AppRow, CandidateRow, EngineRow } from "state.slint";
import { HomePage } from "pages/home.slint";
import { AppsPage } from "pages/apps.slint";
import { SettingsPage } from "pages/settings.slint";

// Strukturen und Globals weiterreichen, damit Python sie ueber diese Datei
// erreichen kann.
export { Store, Actions, AppRow, CandidateRow, EngineRow, Theme }

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    callback clicked();

    height: 42px;
    border-radius: Theme.radius-small;
    background: selected ? Theme.accent.with-alpha(0.18)
        : touch.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            text: icon;
            font-size: 15px;
            vertical-alignment: center;
            width: 20px;
            color: selected ? Theme.accent : Theme.text-muted;
        }
        Text {
            text: label;
            font-size: 13px;
            font-weight: selected ? 700 : 400;
            color: selected ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Local Ally";
    background: Theme.background;
    min-width: 900px;
    min-height: 620px;
    preferred-width: 1040px;
    preferred-height: 700px;

    in-out property <int> page: 0;

    HorizontalLayout {
        // --- Seitenleiste ---
        Rectangle {
            width: 216px;
            background: Theme.sidebar;

            Rectangle {
                width: 1px;
                x: parent.width - 1px;
                background: Theme.border;
            }

            VerticalLayout {
                padding: 14px;
                spacing: 6px;

                // Logo
                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 12px;
                    padding-top: 6px;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 10px;
                        background: @linear-gradient(150deg, #4c8dff 0%, #7a5cff 100%);
                        Text {
                            text: "LA";
                            color: white;
                            font-size: 13px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: "Local Ally";
                            font-size: 14px;
                            font-weight: 800;
                            color: Theme.text;
                        }
                        Text {
                            text: "offline · Version " + Store.version;
                            font-size: 10px;
                            color: Theme.text-faint;
                        }
                    }
                }

                NavItem {
                    label: "Start";
                    icon: "🏠";
                    selected: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    label: "Programme";
                    icon: "🗂";
                    selected: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavItem {
                    label: "Einstellungen";
                    icon: "⚙";
                    selected: root.page == 2;
                    clicked => { root.page = 2; }
                }

                Rectangle { vertical-stretch: 1; }

                // Fusszeile: kurzer Hinweis auf die Bedienung
                Rectangle {
                    height: 84px;
                    border-radius: Theme.radius-small;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        Text {
                            text: "Beispielbefehle";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-muted;
                        }
                        Text {
                            text: "„Öffne Lunar Client“\n„Starte Discord“\n„Spotify öffnen“";
                            font-size: 11px;
                            color: Theme.text-faint;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // --- Inhalt ---
        Rectangle {
            background: Theme.background;

            VerticalLayout {
                padding: Theme.pad;

                if root.page == 0 : HomePage {}
                if root.page == 1 : AppsPage {}
                if root.page == 2 : SettingsPage {}
            }
        }
    }
}
