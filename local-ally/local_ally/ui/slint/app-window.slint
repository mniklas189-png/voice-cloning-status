// Hauptfenster: Navigationsspalte links, Inhalt rechts.
//
// Die Navigation kommt ohne Symbole aus. Emoji sehen je nach
// Schriftinstallation unterschiedlich aus und wirken schnell verspielt;
// eine Textnavigation mit farbigem Aktivbalken bleibt ruhig und lesbar.

import { Theme, Hairline, SectionLabel } from "theme.slint";
import { Store, Actions, AppRow, CandidateRow, CustomRow, CustomForm, EngineRow } from "state.slint";
import { HomePage } from "pages/home.slint";
import { AppsPage } from "pages/apps.slint";
import { CustomPage } from "pages/custom.slint";
import { SettingsPage } from "pages/settings.slint";

// Strukturen und Globals weiterreichen, damit Python sie ueber diese Datei
// erreichen kann.
export { Store, Actions, AppRow, CandidateRow, CustomRow, CustomForm, EngineRow, Theme }

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 36px;
    border-radius: Theme.radius-small;
    background: selected ? Theme.surface : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    // Aktivbalken links
    Rectangle {
        x: 0px;
        y: (parent.height - 16px) / 2;
        width: 2px;
        height: 16px;
        border-radius: 1px;
        background: selected ? Theme.accent : transparent;
    }

    Text {
        x: 14px;
        text: label;
        font-size: 13px;
        font-weight: selected ? 600 : 400;
        color: selected ? Theme.text : Theme.text-muted;
        vertical-alignment: center;
        height: parent.height;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Local Ally";
    background: Theme.background;
    min-width: 940px;
    min-height: 620px;
    preferred-width: 1080px;
    preferred-height: 720px;

    in-out property <int> page: 0;

    HorizontalLayout {
        // --- Navigation ---
        Rectangle {
            width: 212px;
            background: Theme.sidebar;

            // Trennlinie zum Inhalt
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding: 16px;
                spacing: 4px;

                // Bild- und Wortmarke. Die Bildmarke gibt es in zwei
                // Fassungen - eine je Farbschema.
                HorizontalLayout {
                    padding-top: 6px;
                    padding-bottom: 22px;
                    padding-left: 4px;
                    spacing: 10px;

                    Image {
                        source: Theme.dark
                            ? @image-url("../assets/logo-mark-dark.svg")
                            : @image-url("../assets/logo-mark-light.svg");
                        width: 26px;
                        height: 38px;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;

                        Text {
                            text: "LOCAL-ALLY";
                            font-size: 13px;
                            font-weight: 800;
                            letter-spacing: 1.6px;
                            color: Theme.text;
                        }
                        Text {
                            text: "Version " + Store.version + " · offline";
                            font-size: 10px;
                            font-family: Theme.mono;
                            color: Theme.text-faint;
                        }
                    }
                }

                NavItem {
                    label: "Start";
                    selected: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    label: "Programme";
                    selected: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavItem {
                    label: "Eigene Funktionen";
                    selected: root.page == 3;
                    clicked => { root.page = 3; }
                }
                NavItem {
                    label: "Einstellungen";
                    selected: root.page == 2;
                    clicked => { root.page = 2; }
                }

                Rectangle { vertical-stretch: 1; }

                // Fusszeile: was Local Ally gerade kennt. Die Beispielsaetze
                // stehen auf der Startseite, wo sie gebraucht werden.
                VerticalLayout {
                    spacing: 12px;
                    padding-left: 4px;
                    alignment: end;

                    // Laufende Timer stehen hier, weil sie auf jeder Seite
                    // sichtbar bleiben sollen.
                    if Store.timers.length > 0 : VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        Hairline {}

                        VerticalLayout {
                            padding-top: 12px;
                            spacing: 3px;

                            SectionLabel { text: "TIMER"; }

                            for entry in Store.timers : Text {
                                text: entry;
                                font-size: 11px;
                                font-family: Theme.mono;
                                color: Theme.accent;
                            }
                        }
                    }

                    Hairline {}

                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        SectionLabel { text: "PROGRAMM-INDEX"; }

                        Text {
                            text: Store.app-count;
                            font-size: 20px;
                            font-weight: 700;
                            font-family: Theme.mono;
                            color: Store.app-count == 0 ? Theme.text-faint : Theme.text;
                        }
                        Text {
                            text: Store.indexing ? "wird aufgebaut ..."
                                : Store.last-index != "" ? "Stand " + Store.last-index
                                : "noch nicht aufgebaut";
                            font-size: 10px;
                            color: Theme.text-faint;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // --- Inhalt ---
        Rectangle {
            background: Theme.background;

            VerticalLayout {
                padding-left: 26px;
                padding-right: 26px;
                padding-top: 24px;
                padding-bottom: 24px;

                if root.page == 0 : HomePage {}
                if root.page == 1 : AppsPage {}
                if root.page == 2 : SettingsPage {}
                if root.page == 3 : CustomPage {}
            }
        }
    }
}
