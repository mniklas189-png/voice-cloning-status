import { Theme } from "../theme.slint";

// Eigene Eingabefelder statt der Standard-Widgets.
//
// Grund: der Stil der Standard-Widgets (LineEdit, ComboBox) wird beim
// Uebersetzen der .slint-Dateien festgelegt und laesst sich zur Laufzeit
// nicht umschalten. Ein Wechsel zwischen hellem und dunklem Schema wuerde
// sonst nur die Haelfte der Oberflaeche erreichen.

// Einzeiliges Textfeld.
export component TextField inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted(string);

    height: 34px;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent
        : touch.has-hover ? Theme.line-strong : Theme.line;
    background: Theme.surface-raised;
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Rectangle {
            input := TextInput {
                text: root.text;
                font-size: 12px;
                color: Theme.text;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-primary;
                single-line: true;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }

            // Platzhalter, solange nichts eingegeben wurde
            if input.text == "" : Text {
                text: root.placeholder;
                font-size: 12px;
                color: Theme.text-faint;
                x: 0px;
                width: parent.width;
                height: parent.height;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
}

// Auswahl aus wenigen festen Werten - alle sichtbar, keine Aufklappliste.
export component Segmented inherits HorizontalLayout {
    in property <[string]> options;
    in property <string> value;
    callback selected(string);

    spacing: 6px;
    alignment: start;

    for option in options : Rectangle {
        property <bool> active: option == root.value;
        height: 30px;
        width: label.preferred-width + 24px;
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: active ? transparent
            : segment-touch.has-hover ? Theme.line-strong : Theme.line;
        background: active ? Theme.accent
            : segment-touch.has-hover ? Theme.hover : transparent;
        animate background, border-color { duration: 100ms; }

        label := Text {
            text: option;
            font-size: 12px;
            font-weight: active ? 600 : 400;
            color: active ? Theme.on-primary : Theme.text-muted;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        segment-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(option); }
        }
    }
}

// Auswahlliste fuer wechselnde Eintraege (z.B. Mikrofone).
export component OptionList inherits VerticalLayout {
    in property <[string]> options;
    in property <string> value;
    callback selected(string);

    spacing: 2px;

    for option in options : Rectangle {
        property <bool> active: option == root.value;
        height: 30px;
        border-radius: Theme.radius-small;
        background: active ? Theme.surface-raised
            : option-touch.has-hover ? Theme.hover : transparent;

        HorizontalLayout {
            padding-left: 8px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 11px;
                    height: 11px;
                    border-radius: 2px;
                    border-width: 1px;
                    border-color: active ? Theme.accent : Theme.line-strong;
                    Rectangle {
                        x: 3px;
                        y: 3px;
                        width: 5px;
                        height: 5px;
                        border-radius: 1px;
                        background: active ? Theme.accent : transparent;
                    }
                }
            }
            Text {
                text: option;
                font-size: 12px;
                color: active ? Theme.text : Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        option-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(option); }
        }
    }
}
