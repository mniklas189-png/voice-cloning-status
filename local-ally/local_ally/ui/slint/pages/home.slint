import { ScrollView } from "std-widgets.slint";
import { Theme, Panel, Hairline, SectionLabel, StatusChip } from "../theme.slint";
import { Store, Actions, CandidateRow } from "../state.slint";
import { RecordButton } from "../components/record-button.slint";
import { LevelMeter } from "../components/level-meter.slint";

// Eine Zeile der Rueckfrage-Liste.
component CandidateItem inherits Rectangle {
    in property <CandidateRow> candidate;
    callback chosen();

    height: 52px;
    border-radius: Theme.radius-small;
    background: touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 14px;

        // Ziffer zum Ansagen ("sag zwei")
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 3px;
                background: Theme.surface-raised;
                border-width: 1px;
                border-color: Theme.line;
                Text {
                    text: candidate.index;
                    font-size: 11px;
                    font-weight: 700;
                    font-family: Theme.mono;
                    color: Theme.accent;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: candidate.name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: candidate.detail;
                font-size: 11px;
                font-family: Theme.mono;
                color: Theme.text-faint;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            width: 116px;
            Text {
                text: candidate.score;
                font-size: 11px;
                font-family: Theme.mono;
                color: Theme.text-muted;
                horizontal-alignment: right;
            }
            Text {
                text: candidate.reason;
                font-size: 10px;
                color: Theme.text-faint;
                horizontal-alignment: right;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

// Stummschalter. Gleiche Bauform wie der Aufnahmeknopf, damit beide
// zusammengehoerig wirken.
component MuteButton inherits Rectangle {
    height: 46px;
    min-width: 116px;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Store.muted ? Theme.danger
        : touch.has-hover ? Theme.line-strong : Theme.line;
    background: Store.muted ? Theme.danger.with-alpha(0.12)
        : touch.has-hover ? Theme.hover : transparent;
    animate background, border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            // Durchgestrichenes Mikrofon waere ein Symbol - hier reicht ein
            // Balken, der im stummen Zustand aufleuchtet.
            Rectangle {
                width: 12px;
                height: 3px;
                border-radius: 2px;
                background: Store.muted ? Theme.danger : Theme.text-faint;
            }
        }
        Text {
            text: Store.muted ? "Stumm aus" : "Stumm";
            font-size: 13px;
            font-weight: 600;
            color: Store.muted ? Theme.danger : Theme.text-muted;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Actions.toggle-mute(); }
    }
}

// Startseite: Status, Aufnahme, Gehoertes, Aktion.
export component HomePage inherits VerticalLayout {
    spacing: 0px;

    // --- Kopfzeile: Status und Aufnahme ---
    HorizontalLayout {
        spacing: 16px;
        padding-bottom: 18px;

        VerticalLayout {
            alignment: center;
            spacing: 6px;

            StatusChip {
                label: Store.status-label;
                tint: Store.status == "muted" ? Theme.danger
                    : Store.status == "listening" ? Theme.record
                    : Store.status == "waiting_wake" ? Theme.accent
                    : Store.status == "loading" ? Theme.warning
                    : Store.status == "error" ? Theme.danger
                    : Theme.success;
            }
            Text {
                // Der Hinweis erklaert genau den Zustand, in dem man sich
                // gerade befindet - das ersetzt jede Legende.
                text: Store.muted
                        ? (Store.mute-hotkey != "" && Store.hotkeys-ok
                            ? "Stummschaltung aufheben: Knopf oder " + Store.mute-hotkey
                            : "Stummschaltung über den Knopf aufheben.")
                    : !Store.listening
                        ? "Klicke auf Sprechen oder öffne ein Programm aus der Liste."
                    : Store.ptt-active
                        ? "Push-to-Talk: sprich, solange du die Taste hältst."
                    : Store.status == "waiting_wake"
                        ? "Sage „" + Store.wake-word + "“, um einen Befehl zu starten."
                    : Store.wake-armed
                        ? "Wake Word erkannt – sag jetzt deinen Befehl."
                    : "Sprich einen Befehl – zum Beispiel „Öffne Lunar Client“.";
                font-size: 12px;
                color: Theme.text-muted;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;
            MuteButton { horizontal-stretch: 0; }
        }
        VerticalLayout {
            alignment: center;
            RecordButton { horizontal-stretch: 0; }
        }
    }

    LevelMeter {}

    Rectangle { height: 22px; }
    Hairline {}

    // Ergebnisbereich - erscheint erst, wenn es etwas zu zeigen gibt.
    if Store.recognized-text != "" || Store.action-text != "" || Store.wake-heard != "" : VerticalLayout {
        spacing: 0px;
        vertical-stretch: 0;

        // --- Gehoert ---
        VerticalLayout {
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 8px;
            vertical-stretch: 0;

            HorizontalLayout {
                SectionLabel { text: "GEHÖRT"; }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: Store.partial-text;
                    font-size: 11px;
                    font-family: Theme.mono;
                    color: Theme.text-faint;
                    overflow: elide;
                    horizontal-alignment: right;
                }
            }

            Text {
                text: Store.recognized-text != "" ? Store.recognized-text : "—";
                font-size: 21px;
                font-weight: 600;
                color: Store.recognized-text != "" ? Theme.text : Theme.text-faint;
                wrap: word-wrap;
            }

            // Ohne Wake Word verworfen: sichtbar, aber deutlich zurückgenommen.
            if Store.wake-heard != "" : Text {
                text: "ohne Wake Word verworfen: „" + Store.wake-heard + "“";
                font-size: 11px;
                color: Theme.text-faint;
                wrap: word-wrap;
            }
        }

        Hairline {}

        // --- Aktion ---
        VerticalLayout {
            padding-top: 18px;
            spacing: 8px;
            vertical-stretch: 0;

            SectionLabel { text: "AKTION"; }

            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 3px;
                        height: 16px;
                        border-radius: 2px;
                        background: Store.action-text == "" ? transparent
                            : Store.awaiting-choice ? Theme.accent
                            : Store.action-ok ? Theme.success : Theme.danger;
                    }
                }
                Text {
                    text: Store.action-text != "" ? Store.action-text : "—";
                    font-size: 14px;
                    color: Store.action-text == "" ? Theme.text-faint : Theme.text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }
    }

    // --- Rueckfrage bei mehreren Treffern ---
    if Store.candidates.length > 0 : VerticalLayout {
        padding-top: 16px;
        spacing: 10px;
        vertical-stretch: 0;

        HorizontalLayout {
            spacing: 12px;
            SectionLabel { text: "VORSCHLÄGE"; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "Nummer sagen oder anklicken";
                font-size: 11px;
                color: Theme.text-faint;
            }
        }

        Panel {
            // Waechst mit der Zahl der Vorschlaege, deckelt aber die Hoehe.
            height: min(300px, Store.candidates.length * 54px + 14px);
            ScrollView {
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    alignment: start;

                    for candidate[i] in Store.candidates : CandidateItem {
                        candidate: candidate;
                        chosen => { Actions.choose-candidate(i); }
                    }
                }
            }
        }
    }

    // Solange noch nichts erkannt wurde, erklaert die freie Flaeche die
    // Bedienung - besser als ein leerer Block.
    if Store.recognized-text == "" && Store.action-text == "" && Store.wake-heard == "" : VerticalLayout {
        padding-top: 24px;
        spacing: 12px;
        alignment: start;
        vertical-stretch: 0;

        SectionLabel { text: "SO GEHT'S"; }

        // Die Schritte passen sich der Einstellung an - sonst erklaeren sie
        // eine Bedienung, die gerade gar nicht gilt.
        for step[i] in [
            Store.ptt-enabled && Store.ptt-hotkey != ""
                ? "Auf „Sprechen“ klicken – oder " + Store.ptt-hotkey + " gedrückt halten."
                : "Auf „Sprechen“ klicken – Local Ally hört zu.",
            Store.wake-enabled
                ? "Sage „" + Store.wake-word + "“ und dann den Befehl, etwa „Öffne Lunar Client“."
                : "Befehl sagen, zum Beispiel „Öffne Lunar Client“.",
            "Der Name wird mit dem lokalen Programm-Index abgeglichen und gestartet.",
        ] : HorizontalLayout {
            spacing: 12px;

            Text {
                text: i + 1;
                font-size: 12px;
                font-family: Theme.mono;
                color: Theme.accent;
                width: 14px;
            }
            Text {
                text: step;
                font-size: 13px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }

    Rectangle { vertical-stretch: 1; }
}
