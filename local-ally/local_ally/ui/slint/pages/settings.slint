import { ScrollView } from "std-widgets.slint";
import { Theme, Panel, Hairline, SectionLabel, Toggle } from "../theme.slint";
import { TextField, Segmented, OptionList } from "../components/inputs.slint";
import { Store, Actions, EngineRow } from "../state.slint";

// Beschriftete Einstellungszeile: links das Was, rechts das Bedienelement.
component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    padding: 14px;
    spacing: 16px;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        width: 190px;
        Text {
            text: label;
            font-size: 12px;
            color: Theme.text;
        }
        if hint != "" : Text {
            text: hint;
            font-size: 11px;
            color: Theme.text-faint;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        @children
    }
}

// Ein Erkenner zur Auswahl - mit Markierung statt Symbol.
component EngineItem inherits Rectangle {
    in property <EngineRow> engine;
    in property <bool> selected;
    callback chosen();

    height: 58px;
    background: selected ? Theme.surface-raised
        : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        // Auswahlmarkierung
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 2px;
                border-width: 1px;
                border-color: selected ? Theme.accent : Theme.line-strong;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    x: 3px;
                    y: 3px;
                    border-radius: 1px;
                    background: selected ? Theme.accent : transparent;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: engine.name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
            }
            Text {
                text: engine.description;
                font-size: 11px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            width: 230px;
            Text {
                text: engine.available ? "einsatzbereit" : "nicht einsatzbereit";
                font-size: 11px;
                font-weight: 600;
                color: engine.available ? Theme.success : Theme.warning;
                horizontal-alignment: right;
            }
            Text {
                text: engine.detail;
                font-size: 10px;
                font-family: Theme.mono;
                color: Theme.text-faint;
                horizontal-alignment: right;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

// Einstellungen: Spracherkennung, Mikrofon, Verhalten.
export component SettingsPage inherits VerticalLayout {
    spacing: 0px;

    VerticalLayout {
        padding-bottom: 16px;
        spacing: 4px;
        Text {
            text: "Einstellungen";
            font-size: 19px;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: "Änderungen gelten sofort und werden lokal gespeichert.";
            font-size: 11px;
            color: Theme.text-muted;
        }
    }

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            spacing: 22px;
            padding-right: 12px;
            alignment: start;

            // --- Erscheinungsbild ---
            VerticalLayout {
                spacing: 8px;
                SectionLabel { text: "ERSCHEINUNGSBILD"; }

                Panel {
                    Row {
                        label: "Farbschema";
                        hint: "beide Varianten folgen der Bildmarke";
                        Segmented {
                            options: ["Hell", "Dunkel"];
                            value: Theme.dark ? "Dunkel" : "Hell";
                            selected(value) => {
                                Actions.select-theme(value == "Dunkel" ? "dark" : "light");
                            }
                        }
                    }
                }
            }

            // --- Spracherkennung ---
            VerticalLayout {
                spacing: 8px;
                SectionLabel { text: "SPRACHERKENNUNG"; }

                // Die Zeilen sind selbst die Auswahl - eine zusaetzliche
                // Auswahlliste daneben waere doppelt.
                Panel {
                    VerticalLayout {
                        for engine[i] in Store.engines : VerticalLayout {
                            if i > 0 : Hairline {}
                            EngineItem {
                                engine: engine;
                                selected: Store.engine-id == engine.id;
                                chosen => { Actions.select-engine(engine.name); }
                            }
                        }
                    }
                }
            }

            // --- Modelle ---
            VerticalLayout {
                spacing: 8px;
                SectionLabel { text: "MODELLE"; }

                Panel {
                    VerticalLayout {
                        Row {
                            label: "Vosk-Modellordner";
                            hint: "leer = automatisch im Datenordner suchen";
                            TextField {
                                text: Store.vosk-model-path;
                                placeholder: "Pfad eingeben, Enter zum Übernehmen";
                                accepted(value) => { Actions.set-vosk-model-path(value); }
                            }
                        }
                        Hairline {}
                        Row {
                            label: "Whisper-Größe";
                            hint: "größer = genauer, aber langsamer";
                            Segmented {
                                options: Store.whisper-sizes;
                                value: Store.whisper-value;
                                selected(value) => { Actions.select-whisper-size(value); }
                            }
                        }
                    }
                }
            }

            // --- Mikrofon ---
            VerticalLayout {
                spacing: 8px;
                SectionLabel { text: "MIKROFON"; }

                Panel {
                    Row {
                        label: "Eingabegerät";
                        hint: "Standard folgt der Windows-Einstellung";
                        OptionList {
                            options: Store.input-devices;
                            value: Store.input-device-value;
                            selected(value) => { Actions.select-input-device(value); }
                        }
                    }
                }
            }

            // --- Verhalten ---
            VerticalLayout {
                spacing: 8px;
                SectionLabel { text: "VERHALTEN"; }

                Panel {
                    VerticalLayout {
                        Row {
                            label: "Eindeutige Treffer";
                            hint: "sonst fragt Local Ally jedes Mal nach";
                            Toggle {
                                text: "sofort starten";
                                checked: Store.auto-execute;
                                toggled(value) => { Actions.set-auto-execute(value); }
                            }
                        }
                        Hairline {}
                        Row {
                            label: "Suchpfad (PATH)";
                            hint: "Kommandozeilenwerkzeuge ohne Startmenü-Eintrag";
                            Toggle {
                                text: "mit indizieren";
                                checked: Store.include-path;
                                toggled(value) => { Actions.set-include-path(value); }
                            }
                        }
                    }
                }
            }

            if Store.error != "" : Panel {
                background: Theme.danger.with-alpha(0.10);
                border-color: Theme.danger.with-alpha(0.35);
                HorizontalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Rectangle {
                        width: 3px;
                        border-radius: 2px;
                        background: Theme.danger;
                    }
                    Text {
                        text: Store.error;
                        color: Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
