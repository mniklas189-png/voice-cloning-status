import { ListView } from "std-widgets.slint";
import { Theme, Panel, Hairline, SectionLabel, Button } from "../theme.slint";
import { TextField } from "../components/inputs.slint";
import { Store, Actions, AppRow } from "../state.slint";

// Eine Zeile der Programmliste - als Tabelle gedacht, nicht als Kachel.
component AppItem inherits Rectangle {
    in property <AppRow> app;
    callback launch();

    height: 46px;
    background: touch.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            width: 210px;
            Text {
                text: app.name;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: app.detail;
                font-size: 11px;
                font-family: Theme.mono;
                color: Theme.text-faint;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 150px;
            Text {
                text: app.source;
                font-size: 11px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 60px;
            Text {
                text: touch.has-hover ? "Starten" : "";
                font-size: 11px;
                font-weight: 600;
                color: Theme.accent;
                horizontal-alignment: right;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.launch(); }
    }
}

// Seite "Programme": der lokale App-Index.
export component AppsPage inherits VerticalLayout {
    spacing: 0px;

    // --- Kopfzeile ---
    HorizontalLayout {
        spacing: 12px;
        padding-bottom: 16px;

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: "Programme";
                font-size: 19px;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: Store.app-count + " Einträge im lokalen Index"
                    + (Store.last-index != "" ? "  ·  Stand " + Store.last-index : "");
                font-size: 11px;
                color: Theme.text-muted;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;
            width: 240px;
            TextField {
                placeholder: "Suchen ...";
                edited(value) => { Actions.filter-apps(value); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: Store.indexing ? "Suche läuft ..." : "Index aktualisieren";
                enabled: !Store.indexing;
                strong: Store.app-count == 0;
                clicked => { Actions.rebuild-index(); }
            }
        }
    }

    if Store.indexing : VerticalLayout {
        padding-bottom: 12px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 3px;
                border-radius: 2px;
                background: Theme.accent;
            }
            Text {
                text: Store.index-detail;
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }

    Panel {
        vertical-stretch: 1;

        VerticalLayout {
            padding: 1px;

            // Spaltenkoepfe
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 10px;
                spacing: 16px;

                SectionLabel { text: "NAME"; width: 210px; }
                SectionLabel { text: "ZIEL"; horizontal-stretch: 1; }
                SectionLabel { text: "QUELLE"; width: 150px; }
                Rectangle { width: 60px; }
            }

            Hairline {}

            ListView {
                vertical-stretch: 1;
                for app[i] in Store.apps : AppItem {
                    app: app;
                    launch => { Actions.launch-app(app.id); }
                }
            }

            if Store.app-count == 0 && !Store.indexing : VerticalLayout {
                padding: 28px;
                spacing: 6px;
                alignment: center;
                Text {
                    text: "Noch keine Programme im Index.";
                    font-size: 13px;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: "„Index aktualisieren“ durchsucht Startmenü, Registry und Suchpfad.";
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
