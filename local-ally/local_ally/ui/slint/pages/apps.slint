import { Button, LineEdit, ListView } from "std-widgets.slint";
import { Theme, Card } from "../theme.slint";
import { Store, Actions, AppRow } from "../state.slint";

// Seite "Programme": zeigt den lokalen App-Index und erlaubt das Aktualisieren.
export component AppsPage inherits VerticalLayout {
    spacing: Theme.gap;

    HorizontalLayout {
        spacing: 12px;
        alignment: space-between;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Erkannte Programme";
                font-size: 22px;
                font-weight: 800;
                color: Theme.text;
            }
            Text {
                text: Store.app-count + " Programme im lokalen Index"
                    + (Store.last-index != "" ? " · zuletzt aktualisiert: " + Store.last-index : "");
                font-size: 12px;
                color: Theme.text-muted;
            }
        }

        Button {
            text: Store.indexing ? "Suche läuft ..." : "Index aktualisieren";
            enabled: !Store.indexing;
            primary: true;
            clicked => { Actions.rebuild-index(); }
        }
    }

    if Store.indexing : Rectangle {
        height: 36px;
        border-radius: Theme.radius-small;
        background: Theme.surface-raised;
        Text {
            x: 12px;
            text: "⏳ " + Store.index-detail;
            font-size: 12px;
            color: Theme.warning;
            vertical-alignment: center;
        }
    }

    LineEdit {
        placeholder-text: "Programm suchen ...";
        edited(value) => { Actions.filter-apps(value); }
    }

    Card {
        vertical-stretch: 1;

        ListView {
            for app[i] in Store.apps : Rectangle {
                height: 54px;
                background: item-touch.has-hover ? Theme.surface-raised : transparent;
                border-radius: Theme.radius-small;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: app.name;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: app.detail;
                            font-size: 11px;
                            color: Theme.text-faint;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 132px;
                        Text {
                            text: app.source;
                            font-size: 11px;
                            color: Theme.text-muted;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            width: parent.width;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 76px;
                        Rectangle {
                            width: 68px;
                            height: 26px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 13px;
                            background: item-touch.has-hover ? Theme.accent : Theme.surface-raised;
                            border-width: 1px;
                            border-color: Theme.border;
                            Text {
                                text: "Starten";
                                font-size: 11px;
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }
                }

                item-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Actions.launch-app(app.id); }
                }
            }
        }
    }

    if Store.app-count == 0 && !Store.indexing : Text {
        text: "Noch keine Programme im Index. Klicke auf „Index aktualisieren“.";
        font-size: 12px;
        color: Theme.text-muted;
    }
}
